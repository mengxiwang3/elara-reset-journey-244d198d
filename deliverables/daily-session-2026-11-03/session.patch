+beforeAll(() => {
+  process.env.TZ = ZONE;
+});
+afterAll(() => {
+  if (originalTz === undefined) delete process.env.TZ;
+  else process.env.TZ = originalTz;
+});
+
+/** Money, in Spanish, as the app renders it offline. */
