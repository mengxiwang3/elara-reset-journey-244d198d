   const map = usePathsMap();
diff --git a/apps/mobile/src/lib/dayPin.test.ts b/apps/mobile/src/lib/dayPin.test.ts
new file mode 100644
index 0000000..daafa1d
--- /dev/null
+++ b/apps/mobile/src/lib/dayPin.test.ts
@@ -0,0 +1,59 @@
+import { describe, expect, it } from "vitest";
+import { nextDayPin, sameSteps, type DayPin, type LiveDay } from "./dayPin";
+
+const bundled = { name: "bundled" };
+const server = { name: "server" };
+const serverAgain = { name: "server, refetched" };
+
+const live = (path: object, fromServer: boolean, locale = "es", same = false): LiveDay<object> => ({
+  locale,
+  path,
+  hasDay: true,
+  fromServer,
+  sameSteps: same,
+});
+const pin = (path: object, fromServer: boolean, locale = "es"): DayPin<object> => ({ locale, path, fromServer });
+
+describe("the day screen's pinned copy", () => {
+  it("pins the first copy it gets", () => {
+    expect(nextDayPin(null, live(bundled, false), false)).toEqual(pin(bundled, false));
+    expect(nextDayPin(null, live(server, true), false)).toEqual(pin(server, true));
+  });
+
+  // The regression: a day opened cold (direct link, notification, Onboarding's
+  // Day 1, a slow network) pinned the bundled copy and never let go, so she
+  // saw other words than the server's, and answers to steps the server names
+  // differently were refused (404) and stuck on the phone.
+  it("lets the server copy replace the bundled one when it arrives, before she has answered", () => {
+    expect(nextDayPin(pin(bundled, false), live(server, true), false)).toEqual(pin(server, true));
+  });
+
+  it("after she has answered, takes the server copy only when its steps are the same (only the words change)", () => {
+    expect(nextDayPin(pin(bundled, false), live(server, true, "es", true), true)).toEqual(pin(server, true));
+    expect(nextDayPin(pin(bundled, false), live(server, true, "es", false), true)).toBeNull();
+  });
+
+  it("compares steps by id and kind, in order", () => {
+    const a = [{ id: "ask", kind: "choose" }, { id: "take", kind: "reflect" }];
+    expect(sameSteps(a, [{ id: "ask", kind: "choose" }, { id: "take", kind: "reflect" }])).toBe(true);
+    expect(sameSteps(a, [{ id: "hardest", kind: "choose" }, { id: "take", kind: "reflect" }])).toBe(false);
+    expect(sameSteps(a, [{ id: "ask", kind: "multi" }, { id: "take", kind: "reflect" }])).toBe(false);
+    expect(sameSteps(a, [...a, { id: "more", kind: "reflect" }])).toBe(false);
+  });
+
+  it("keeps the server copy against later refetches, as before", () => {
+    expect(nextDayPin(pin(server, true), live(serverAgain, true), false)).toBeNull();
+    expect(nextDayPin(pin(server, true), live(bundled, false), false)).toBeNull();
+  });
+
+  it("takes a new copy for a new language, as before", () => {
+    expect(nextDayPin(pin(server, true, "es"), live(bundled, false, "en"), true)).toEqual(pin(bundled, false, "en"));
+  });
+
+  it("waits while the live path has no such day", () => {
+    expect(nextDayPin(null, { locale: "es", path: bundled, hasDay: false, fromServer: false, sameSteps: false }, false)).toBeNull();
+    expect(
+      nextDayPin(pin(bundled, false), { locale: "es", path: undefined, hasDay: false, fromServer: true, sameSteps: false }, false),
+    ).toBeNull();
+  });
+});
diff --git a/apps/mobile/src/lib/dayPin.ts b/apps/mobile/src/lib/dayPin.ts
new file mode 100644
index 0000000..87754ce
--- /dev/null
+++ b/apps/mobile/src/lib/dayPin.ts
@@ -0,0 +1,53 @@
+/**
+ * Which copy of a day the day screen keeps on screen (`app/path/day.tsx`).
+ *
+ * The day's content is pinned for the life of the screen so a refetch cannot
+ * rebuild the day under her. But the first copy available on a cold open (a
+ * direct link, a notification, Onboarding's "start Day 1", a slow network) is
+ * the bundled fallback, not the CMS copy the server checks answers against.
+ * Pinned for good, that showed different words from the ones everyone else
+ * saw, and where the two copies name a step differently every answer was
+ * refused (`step_not_found`, 404) and sat on the phone as "Guardando tu lugar".
+ *
+ * So the bundled pin is provisional: it gives way to the server copy once,
+ * when that arrives — at once while she has not sent an answer from this
+ * screen, and after that only when the server's day has exactly the same steps
+ * (ids and kinds), so only the words change and no screen, cursor or answer
+ * moves under her. A server day shaped differently after she has answered is
+ * left as it was, as before. Pure, so it runs in Node (`dayPin.test.ts`).
+ */
+export interface DayPin<P> {
+  locale: string;
+  path: P;
+  /** The CMS copy (as opposed to the bundled fallback). */
+  fromServer: boolean;
+}
+
+export interface LiveDay<P> {
+  locale: string;
+  path: P | undefined;
+  /** The live path has this day at all. */
+  hasDay: boolean;
+  /** The live path is the CMS copy for this area. */
+  fromServer: boolean;
+  /** The live day has the same steps (ids and kinds, in order) as the pinned one. */
+  sameSteps: boolean;
+}
+
+/** The same steps, in order, by id and kind: what screens, answers and the cursor are keyed by. */
+export function sameSteps(a: readonly { id: string; kind: string }[], b: readonly { id: string; kind: string }[]): boolean {
+  return a.length === b.length && a.every((s, i) => s.id === b[i]!.id && s.kind === b[i]!.kind);
+}
+
+/**
+ * The pin to set now, or `null` to keep the current one.
+ *
+ * `answered`: she has sent an answer (or a skip) from this screen.
+ */
+export function nextDayPin<P>(pinned: DayPin<P> | null, live: LiveDay<P>, answered: boolean): DayPin<P> | null {
+  if (!live.path || !live.hasDay) return null;
+  const take = { locale: live.locale, path: live.path, fromServer: live.fromServer };
+  if (!pinned || pinned.locale !== live.locale) return take;
+  if (!pinned.fromServer && live.fromServer && pinned.path !== live.path && (!answered || live.sameSteps)) return take;
+  return null;
+}
