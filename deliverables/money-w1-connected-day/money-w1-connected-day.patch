diff --git a/apps/mobile/src/lib/souvenir.ts b/apps/mobile/src/lib/souvenir.ts
new file mode 100644
index 0000000..d8fb8d1
--- /dev/null
+++ b/apps/mobile/src/lib/souvenir.ts
@@ -0,0 +1,55 @@
+import { stepsOf, weekOf, worldsFor, type AnswerBook, type AreaKey, type PathDayDTO } from "@elara/shared";
+
+/**
+ * A finished day's souvenir: the object (or, where a place has no drawn
+ * keepsake yet, the place itself) she can collect at the end of the day and
+ * find again in the Atlas.
+ *
+ * Pure and free of React Native and images, so it is tested in Node. The art
+ * and the name are looked up by the screen (`keepsakeArt`, `souvenirName`);
+ * this module only answers which world and day a souvenir belongs to, whether
+ * it is hers to collect, and what she kept that day.
+ */
+
+/** The store key for one day's souvenir. */
+export const souvenirKey = (area: AreaKey, day: number) => `${area}:${day}`;
+
+/** Where a day's souvenir comes from: its world and its place in the week (1..7). */
+export function souvenirWhere(
+  area: AreaKey,
+  day: number,
+  config?: { week?: number },
+): { worldId: string; week: number; dayInWeek: number } | null {
+  if (!Number.isInteger(day) || day < 1) return null;
+  const week = weekOf(day, config);
+  const world = worldsFor(area)[week - 1];
+  if (!world) return null;
+  return { worldId: world.id, week, dayInWeek: ((day - 1) % 7) + 1 };
+}
+
+/**
+ * The list after collecting one more souvenir. The same list (by reference)
+ * when it was already there, so a second tap, a replay or a redo changes
+ * nothing and the caller can tell.
+ */
+export function withCollected(list: readonly string[], area: AreaKey, day: number): string[] {
+  const key = souvenirKey(area, day);
+  return list.includes(key) ? (list as string[]) : [...list, key];
+}
+
+export function isCollected(list: readonly string[], area: AreaKey, day: number): boolean {
+  return list.includes(souvenirKey(area, day));
+}
+
+/**
+ * Whether a day's souvenir can be collected: the day is complete, and it was
+ * not declined ("I'd rather not do this today" is not something she did, so it
+ * earns nothing, as in `docs/DAY-STEPS.md`).
+ */
+export function canCollect(day: PathDayDTO | undefined, book: AnswerBook, completedDays: readonly number[]): boolean {
+  if (!day || !completedDays.includes(day.day)) return false;
+  const answers = book[day.day] ?? {};
+  const steps = stepsOf(day);
+  if (steps.length && steps.every((s) => answers[s.id]?.state === "declined")) return false;
+  return true;
+}
