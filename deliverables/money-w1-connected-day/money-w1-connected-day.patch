+// ── Teaching reply: an authored line that quotes what she gave ─────────────
+
+/** `{d3.step}`: a reference to another day, which a teaching line never makes. */
+const OTHER_DAY = /\{d\d{1,2}\./;
+
+/**
+ * The step's authored teaching reply (`config.teach`) for the answer she gave,
+ * or null.
+ *
+ * The templates are tried in order and the first that fills completely wins,
+ * so a line that quotes her words gives way to a plainer one when her words
+ * cannot be quoted (too long, a non-answer). Nothing comes back for a skip, a
+ * state ("Not now", "I'm not sure"), an empty answer or a `hidden` step: there
+ * is nothing of hers to teach from, and the step's ordinary line covers it.
+ * A template that names another day is ignored, so the server, which knows
+ * only this day's steps, and the phone always agree.
+ */
+export function teachingReply(step: DayStep, ctx: TemplateContext): string | null {
+  const templates = step.config?.teach;
+  if (!templates?.length || step.config?.hidden) return null;
+  const saved = ctx.book[ctx.day]?.[step.id];
+  if (!saved || hasStateAnswer(saved) || !answerText(saved.value, step).trim()) return null;
+  for (const template of templates) {
+    if (!template.trim() || OTHER_DAY.test(template)) continue;
+    const filled = fillTemplate(template, ctx);
+    if (filled.complete && !filled.withheld && !/[{}]/.test(filled.text)) return filled.text.trim();
+  }
+  return null;
+}
+
