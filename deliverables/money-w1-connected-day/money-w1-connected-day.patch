+import { useEffect, useState } from "react";
+import { Animated, Easing, Image, StyleSheet, View } from "react-native";
+import type { AreaKey } from "@elara/shared";
+import { AppText } from "@/components/AppText";
+import { Icon } from "@/components/Icon";
+import { dayPhoto } from "@/content/dayImages";
+import { keepsakeArt } from "@/content/keepsakeImages";
+import { hereIndexFor, stopsKeyFor } from "@/content/placeDay";
+import { placeOfWorld } from "@/content/places";
+import { useT, type Strings } from "@/i18n";
+import { canCollect, isCollected, souvenirWhere } from "@/lib/souvenir";
+import { haptics, PressableScale, pressOpacity, useReducedMotion } from "@/motion";
+import { usePathsMap } from "@/hooks/usePaths";
+import { useAppStore } from "@/store/useAppStore";
+import { colors, radius, spacing, withAlpha } from "@/theme";
+
+/**
+ * A finished day's souvenir: a small stamp she can tap to keep in her Atlas,
+ * then a plain "In your Atlas". Used on the day's completion screen and on the
+ * day's page in the Atlas, so both read the same souvenir and the same state.
+ *
+ * The art is the place's own drawn keepsake where the client has drawn one
+ * (Wuzhen), else the day's own photograph: the same rule as Hoy's week discs,
+ * so a place is never shown with another city's picture. Collecting is a tap,
+ * one short settle of the stamp (none under Reduce Motion), and a stored key:
+ * a second tap, a replay or a redo never collects twice. No points, no count.
+ *
+ * What she kept that day is not repeated here: the completion screen says it
+ * in Elara's line, and the Atlas page lists her current words under it.
+ */
+export function SouvenirStamp({ area, day }: { area: AreaKey; day: number }) {
+  const t = useT();
+  const reduced = useReducedMotion();
+  const path = usePathsMap()[area];
+  const progress = useAppStore((s) => s.progress[area]);
+  const collected = useAppStore((s) => isCollected(s.keepsakesCollected, area, day));
+  const collect = useAppStore((s) => s.collectKeepsake);
+
+  const content = path?.days.find((d) => d.day === day);
+  const where = souvenirWhere(area, day, content?.config);
+  const place = where ? placeOfWorld(where.worldId) : null;
+  const book = progress?.stepAnswers ?? {};
+  const completed = progress?.completedDays ?? [];
+  const eligible = canCollect(content, book, completed);
+
+  // Made once, on mount, in the state it should open in: collected or not.
+  const [settle] = useState(() => new Animated.Value(collected ? 1 : 0));
+  const [justNow, setJustNow] = useState(false);
+  useEffect(() => {
+    if (collected && !justNow) settle.setValue(1);
+  }, [collected, justNow, settle]);
+
+  if (!where || !place || !eligible) return null;
+
+  const own = keepsakeArt(place.id, where.dayInWeek);
+  const art = own ?? dayPhoto(area, where.week, where.dayInWeek).source;
+  const name = souvenirName(t, place.id, where.dayInWeek);
+  const placeName = t.globe.places[place.id]?.name ?? "";
+  const context = t.practice.souvenir.where(placeName, where.dayInWeek);
+
+  const onCollect = () => {
+    if (!collect(area, day)) return;
+    haptics.success();
+    setJustNow(true);
+    if (reduced) {
+      settle.setValue(1);
+      return;
+    }
+    settle.setValue(0);
+    Animated.timing(settle, { toValue: 1, duration: 420, easing: Easing.out(Easing.back(1.6)), useNativeDriver: true }).start();
+  };
+
+  const scale = settle.interpolate({ inputRange: [0, 1], outputRange: [1.12, 1] });
+  const rotate = settle.interpolate({ inputRange: [0, 1], outputRange: ["-9deg", "-3deg"] });
+  const mark = settle.interpolate({ inputRange: [0, 0.6, 1], outputRange: [0, 0, 1] });
+
+  return (
+    <View style={styles.card} accessible={false}>
+      <Animated.View
+        style={[styles.stamp, collected ? { transform: [{ scale }, { rotate }] } : styles.stampIdle]}
+        accessibilityElementsHidden
+        importantForAccessibility="no-hide-descendants"
+      >
+        <Image source={art} style={styles.art} resizeMode="cover" />
+        {collected ? <Animated.View style={[styles.postmark, { opacity: mark }]} /> : null}
+      </Animated.View>
+      <View style={styles.words}>
+        <AppText variant="label" color={colors.textSecondary}>
+          {t.practice.souvenir.eyebrow}
+        </AppText>
+        <AppText variant="cardTitle" color={colors.foreground}>
+          {name}
+        </AppText>
+        <AppText variant="detail" color={colors.textSecondary}>
+          {own ? context : `${context} · ${t.practice.souvenir.photo}`}
+        </AppText>
+        {collected ? (
+          <View style={styles.done} accessible accessibilityLiveRegion="polite" accessibilityLabel={t.practice.souvenir.collectedA11y(name)}>
+            <Icon name="solar:check-circle-bold" size={16} color={colors.buttonForest} />
+            <AppText variant="control" color={colors.buttonForest}>
+              {t.practice.souvenir.collected}
+            </AppText>
+          </View>
+        ) : (
+          <PressableScale
+            size="chip"
+            dim={pressOpacity}
+            onPress={onCollect}
+            accessibilityRole="button"
+            accessibilityLabel={t.practice.souvenir.collectA11y(name)}
+            style={styles.collect}
+          >
+            <AppText variant="control" color={colors.foreground}>
+              {t.practice.souvenir.collect}
+            </AppText>
+          </PressableScale>
+        )}
+      </View>
+    </View>
+  );
+}
+
+/** A day's souvenir by name: the place's own keepsake where it has one, else the stop its photograph shows. */
+export function souvenirName(t: Strings, placeId: string, dayInWeek: number): string {
+  const own = (t.home.hoy.keepsakes as Record<string, readonly string[] | undefined>)[placeId]?.[dayInWeek - 1];
+  if (own) return capitalize(own);
+  const stops = t.globe.stops[stopsKeyFor({ id: placeId as never })];
+  return stops[hereIndexFor(dayInWeek)] ?? "";
+}
+
+const capitalize = (s: string) => (s ? s.charAt(0).toUpperCase() + s.slice(1) : s);
+
+const STAMP_W = 68;
+
+const styles = StyleSheet.create({
+  card: {
+    flexDirection: "row",
+    alignItems: "flex-start",
+    gap: spacing[4],
+    paddingVertical: spacing[3],
+  },
+  stamp: {
+    width: STAMP_W,
+    height: Math.round(STAMP_W * 1.2),
+    padding: 4,
+    borderRadius: radius.sm,
+    backgroundColor: colors.atlasPaper,
+    borderWidth: 1,
+    borderStyle: "dashed",
+    borderColor: withAlpha(colors.foreground, 0.28),
+    shadowColor: "#000",
+    shadowOpacity: 0.12,
+    shadowRadius: 3,
+    shadowOffset: { width: 0, height: 1 },
+    elevation: 2,
+  },
+  stampIdle: { transform: [{ rotate: "-3deg" }], opacity: 0.92 },
+  art: { flex: 1, width: "100%", borderRadius: 2 },
+  postmark: {
+    position: "absolute",
+    right: -10,
+    bottom: -8,
+    width: 34,
+    height: 34,
+    borderRadius: 17,
+    borderWidth: 2,
+    borderColor: withAlpha(colors.buttonForest, 0.7),
+  },
+  words: { flex: 1, minWidth: 0, gap: spacing[1] },
+  collect: {
+    alignSelf: "flex-start",
+    marginTop: spacing[2],
+    minHeight: 44,
+    justifyContent: "center",
+    paddingHorizontal: spacing[4],
+    borderRadius: radius.full,
+    borderWidth: 1,
+    borderColor: withAlpha(colors.foreground, 0.22),
+  },
+  done: { flexDirection: "row", alignItems: "center", gap: spacing[1.5], marginTop: spacing[2], minHeight: 44 },
+});
