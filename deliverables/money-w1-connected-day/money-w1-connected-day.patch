diff --git a/apps/mobile/src/content/moneyDayThreeSlice.test.ts b/apps/mobile/src/content/moneyDayThreeSlice.test.ts
new file mode 100644
index 0000000..bebb844
--- /dev/null
+++ b/apps/mobile/src/content/moneyDayThreeSlice.test.ts
@@ -0,0 +1,143 @@
+import { describe, expect, it } from "vitest";
+import {
+  offeredBook,
+  prefillFor,
+  resolveTemplate,
+  stepsOf,
+  teachingReply,
+  type AnswerBook,
+  type PathDayDTO,
+  type TemplateContext,
+} from "@elara/shared";
+import { collectionFor } from "@/components/practice/collection";
+import { composeDay, PATH_STRUCTURE } from "@/content/paths";
+import { en } from "@/i18n/locales/en";
+import { es } from "@/i18n/locales/es";
+import { canCollect, isCollected, souvenirKey, souvenirWhere, withCollected } from "@/lib/souvenir";
+
+/**
+ * The Money Week 1 vertical slice (Nov 2026), on the real content in both
+ * languages: Day 3 teaches from what she listed, her takeaway is an editable
+ * note started from her own payments, the note she confirms is what her kit
+ * and the next day carry (never an earlier version, a skip or a state), and
+ * the day's souvenir is collected once.
+ */
+
+const LANGS = [
+  ["es", es],
+  ["en", en],
+] as const;
+
+const daysOf = (lang: typeof es | typeof en) =>
+  PATH_STRUCTURE.money.days.map((d, i) => composeDay(d, lang.pathContent.byArea.money.days[i]));
+
+const ctxFor = (days: PathDayDTO[], book: AnswerBook, day: number): TemplateContext => ({
+  book: offeredBook(book, (d) => (days[d - 1] ? stepsOf(days[d - 1]) : undefined)),
+  day,
+  stepAt: (d, id) => (days[d - 1] ? stepsOf(days[d - 1]).find((s) => s.id === id) : undefined),
+});
+
+for (const [code, lang] of LANGS) {
+  const days = daysOf(lang);
+  const [ask3, take3] = stepsOf(days[2]);
+  const ask4 = stepsOf(days[3])[0];
+  const confirm = code === "es" ? "por confirmar" : "to confirm";
+
+  describe(`Money Day 3 and its callback (${code})`, () => {
+    it("keeps the document's question and takeaway, and only adds what teaches", () => {
+      expect(stepsOf(days[2]).map((s) => s.id)).toEqual(["ask", "take"]);
+      expect(ask3.kind).toBe("blanks");
+      expect(take3.config?.keep).toBe("sentence");
+      expect(ask3.config?.eyebrow).toBeTruthy();
+      expect(ask3.config?.teach?.length).toBeGreaterThan(0);
+      expect(take3.config?.teach?.length).toBeGreaterThan(0);
+    });
+
+    it("teaches from the payments she listed, and from nothing she did not", () => {
+      const two: AnswerBook = { 3: { ask: { value: ["Renta", "Luz", ""] } } };
+      const said = teachingReply(ask3, ctxFor(days, two, 3));
+      expect(said).toContain("Renta");
+      expect(said).toContain("Luz");
+      expect(said).toContain(confirm);
+      // The lesson's method, named whatever she wrote.
+      expect(teachingReply(ask3, ctxFor(days, { 3: { ask: { value: ["", "Luz", ""] } } }, 3))).not.toContain("Luz");
+      // Skipped: no teaching line; the step's authored line covers it.
+      expect(teachingReply(ask3, ctxFor(days, { 3: { ask: { value: null } } }, 3))).toBeNull();
+    });
+
+    it("starts her note from her own payments, editable, and empty when she listed none", () => {
+      const two: AnswerBook = { 3: { ask: { value: ["Renta", "Luz", ""] } } };
+      expect(prefillFor(take3, two[3], ctxFor(days, two, 3))).toBe(`Renta: ${confirm}. Luz: ${confirm}.`);
+      const one: AnswerBook = { 3: { ask: { value: ["Renta", "", ""] } } };
+      expect(prefillFor(take3, one[3], ctxFor(days, one, 3))).toBe(`Renta: ${confirm}.`);
+      const none: AnswerBook = { 3: { ask: { value: null } } };
+      expect(prefillFor(take3, none[3], ctxFor(days, none, 3))).toBe("");
+    });
+
+    it("answers her confirmed note by quoting it", () => {
+      const book: AnswerBook = { 3: { ask: { value: ["Renta", "", ""] }, take: { value: "Renta: día 5." } } };
+      expect(teachingReply(take3, ctxFor(days, book, 3))).toContain("Renta: día 5");
+    });
+
+    it("Day 4 recalls the note as it stands now: the edit, never the first version", () => {
+      const first: AnswerBook = { 3: { take: { value: `Renta: ${confirm}.` } } };
+      const edited: AnswerBook = { 3: { take: { value: "Renta: día 5." } } };
+      const before = resolveTemplate(ask4.body, ask4.config?.bodyFallback, ctxFor(days, first, 4));
+      const after = resolveTemplate(ask4.body, ask4.config?.bodyFallback, ctxFor(days, edited, 4));
+      expect(before?.text).toContain(confirm);
+      expect(after?.text).toContain("Renta: día 5");
+      expect(after?.text).not.toContain(confirm);
+      // Her words are set apart as hers.
+      expect(after?.parts.some((p) => p.quoted && p.text.startsWith("Renta: día 5"))).toBe(true);
+    });
+
+    it("Day 4 says nothing of a note she skipped, said «Not now» to, or never reached", () => {
+      for (const take of [{ value: null }, { value: null, state: "notNow" as const }, undefined]) {
+        const book: AnswerBook = take ? { 3: { take } } : {};
+        const said = resolveTemplate(ask4.body, ask4.config?.bodyFallback, ctxFor(days, book, 4));
+        expect(said?.text).toBe(ask4.config?.bodyFallback);
+      }
+    });
+
+    it("her kit holds the note she confirmed, current wording only, and nothing for a skip", () => {
+      const keptOn3 = (book: AnswerBook) =>
+        collectionFor(days, book, [1, 2, 3])
+          .flatMap((w) => w.items)
+          .filter((i) => i.day === 3);
+      expect(keptOn3({ 3: { take: { value: "Renta: día 5." } } })).toEqual([
+        expect.objectContaining({ kind: "sentence", step: "take", text: "Renta: día 5." }),
+      ]);
+      expect(keptOn3({ 3: { take: { value: null } } })).toEqual([]);
+      expect(keptOn3({ 3: { take: { value: null, state: "notNow" } } })).toEqual([]);
+    });
+  });
+}
+
+describe("the day's souvenir", () => {
+  const days = daysOf(es);
+
+  it("comes from the day's own world and place in the week", () => {
+    expect(souvenirWhere("money", 3)).toEqual({ worldId: "mist-meadow", week: 1, dayInWeek: 3 });
+    expect(souvenirWhere("money", 10)).toEqual({ worldId: "celestial-night", week: 2, dayInWeek: 3 });
+    expect(souvenirWhere("money", 0)).toBeNull();
+  });
+
+  it("is collected once: a second tap, a replay or a redo keeps one", () => {
+    const once = withCollected([], "money", 3);
+    const twice = withCollected(once, "money", 3);
+    expect(once).toEqual([souvenirKey("money", 3)]);
+    expect(twice).toBe(once);
+    expect(isCollected(twice, "money", 3)).toBe(true);
+    expect(isCollected(twice, "money", 4)).toBe(false);
+  });
+
+  it("is offered only for a finished day, and never for a declined one", () => {
+    const day3 = days[2];
+    expect(canCollect(day3, {}, [])).toBe(false);
+    expect(canCollect(day3, { 3: { ask: { value: ["Renta", "", ""] } } }, [3])).toBe(true);
+    // Finished with everything skipped still counts: she walked the day.
+    expect(canCollect(day3, { 3: { ask: { value: null }, take: { value: null } } }, [3])).toBe(true);
+    const declined = { 3: { ask: { value: null, state: "declined" as const }, take: { value: null, state: "declined" as const } } };
+    expect(canCollect(day3, declined, [3])).toBe(false);
+  });
+});
