new file mode 100644
index 0000000..2818ec3
--- /dev/null
+++ b/apps/api/test/teaching-reply.test.ts
@@ -0,0 +1,164 @@
+import { drizzle } from "drizzle-orm/better-sqlite3";
+import { Hono } from "hono";
+import { beforeEach, describe, expect, it, vi } from "vitest";
+import { teachingReply, type DayStep } from "@elara/shared";
+import type { Db } from "../src/db";
+import type { AppEnv, Bindings } from "../src/env";
+import { renderError } from "../src/lib/errors";
+import me from "../src/routes/me";
+import { createSqlite, d1Over } from "./helpers/d1";
+import { schema, seedUser } from "./helpers/db";
+
+/**
+ * `config.teach` (Money W1 slice, Nov 2026): an authored teaching line that
+ * quotes what she gave. When one fills, it is the reply: shown, stored, never
+ * handed to the reply model, and rewritten when she edits her answer.
+ */
+
+const ASK: DayStep = {
+  id: "ask",
+  kind: "blanks",
+  title: "Which payments need your attention before money next arrives?",
+  elara: "Noted.",
+  config: {
+    optional: true,
+    fields: ["Item 1", "Item 2", "Item 3"],
+    teach: [
+      "You listed “{ask#1}” and “{ask#2}”. What orders them is the date.",
+      "You listed “{ask#1}”. What orders it is the date.",
+      "What orders a payment is the date.",
+    ],
+  },
+};
+const TAKE: DayStep = {
+  id: "take",
+  kind: "reflect",
+  title: "To take with you",
+  elara: "Whatever you wrote, you can come back to it.",
+  config: { optional: true, modes: ["write"], keep: "sentence", teach: ["Your note: “{take}”.", "Your note is saved."] },
+};
+
+const ctx = (answers: Record<string, unknown>) => ({
+  book: { 3: Object.fromEntries(Object.entries(answers).map(([k, v]) => [k, v as never])) },
+  day: 3,
+  stepAt: (_d: number, id: string) => [ASK, TAKE].find((s) => s.id === id),
+});
+
+describe("teachingReply", () => {
+  it("quotes what she gave, falling back template by template", () => {
+    expect(teachingReply(ASK, ctx({ ask: { value: ["Rent", "Electricity", ""] } }))).toBe(
+      "You listed “Rent” and “Electricity”. What orders them is the date.",
+    );
+    expect(teachingReply(ASK, ctx({ ask: { value: ["Rent", "", ""] } }))).toBe("You listed “Rent”. What orders it is the date.");
+    // The first blank empty: no sentence with a hole in it, the plain line.
+    expect(teachingReply(ASK, ctx({ ask: { value: ["", "Phone", ""] } }))).toBe("What orders a payment is the date.");
+  });
+
+  it("says nothing for a skip, an empty answer, a state or a hidden step", () => {
+    expect(teachingReply(ASK, ctx({ ask: { value: null } }))).toBeNull();
+    expect(teachingReply(ASK, ctx({ ask: { value: ["", "", ""] } }))).toBeNull();
+    expect(teachingReply(ASK, ctx({ ask: { value: null, state: "notNow" } }))).toBeNull();
+    expect(teachingReply(ASK, ctx({}))).toBeNull();
+    const hidden: DayStep = { ...ASK, config: { ...ASK.config, hidden: true } };
+    expect(teachingReply(hidden, ctx({ ask: { value: ["Rent", "", ""] } }))).toBeNull();
+  });
+
+  it("never quotes another day, so the phone and the server always agree", () => {
+    const other: DayStep = { ...TAKE, config: { ...TAKE.config, teach: ["Like day 2: “{d2.take}”.", "Plain."] } };
+    expect(teachingReply(other, ctx({ take: { value: "Rent: the 5th." } }))).toBe("Plain.");
+  });
+
+  it("a step without `teach` has none (every existing day is unchanged)", () => {
+    const plain: DayStep = { ...TAKE, config: { ...TAKE.config, teach: undefined } };
+    expect(teachingReply(plain, ctx({ take: { value: "Rent: the 5th." } }))).toBeNull();
+  });
+});
+
+function harness() {
+  const sqlite = createSqlite();
+  const db = drizzle(sqlite, { schema }) as unknown as Db;
+  const app = new Hono<AppEnv>();
+  app.onError(renderError);
+  app.use("*", async (c, next) => {
+    c.set("user", { id: "ana", email: "ana@example.test", name: "ana", role: "user", isAnonymous: false });
+    c.set("locale", "en");
+    await next();
+  });
+  app.route("/api/me", me);
+  const run = vi.fn(async () => ({ response: "A generated reply that should not be used here." }));
+  const limiter = { check: vi.fn(async () => ({ allowed: true, retryAfter: 0 })) };
+  const env = {
+    DB: d1Over(sqlite),
+    DAY_UNLOCK: "open",
+    AI: { run },
+    RATE_LIMITER: { idFromName: (n: string) => n, get: () => limiter },
+  } as unknown as Bindings;
+  const pending: Promise<unknown>[] = [];
+  const step = async (body: Record<string, unknown>) => {
+    const res = await app.request(
+      "/api/me/paths/money/days/1/steps",
+      { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify(body) },
+      env,
+      { waitUntil: (p: Promise<unknown>) => pending.push(p), passThroughOnException() {} } as never,
+    );
+    await Promise.allSettled(pending.splice(0));
+    return res;
+  };
+  /** Whether the reply model (not the separate personalisation pass) was ever asked. */
+  const askedForReply = () => run.mock.calls.some((c) => JSON.stringify(c).includes("You are responding to one step"));
+  return { db, step, run, askedForReply };
+}
+
+async function seedDay(db: Db) {
+  await seedUser(db, "ana");
+  await db.insert(schema.pathContent).values({
+    id: "path-money-en", area: "money", locale: "en", label: "MONEY", name: "Money",
+    areaName: "Money", icon: "i", accent: "#000", tagline: "t", published: true,
+  });
+  await db.insert(schema.pathDay).values({
+    id: "money-en-1", pathContentId: "path-money-en", day: 1, level: "1", title: "Day 1", kind: "reflect",
+    steps: [ASK, TAKE].map((s) => ({ ...s, config: { ...s.config, teach: s.config!.teach!.map((t) => t.replace(/\{d\d\./, "{")) } })),
+  });
+}
+
+type StepResponse = { reply: { reply: string | null; generated: boolean } };
+
+describe("the steps route with a teaching line", () => {
+  beforeEach(() => {
+    vi.spyOn(console, "error").mockImplementation(() => {});
+    vi.spyOn(console, "warn").mockImplementation(() => {});
+    vi.spyOn(console, "log").mockImplementation(() => {});
+  });
+
+  it("replies with the filled line, stores it, and never asks the reply model", async () => {
+    const h = harness();
+    await seedDay(h.db);
+    const res = await h.step({ stepId: "ask", value: ["Rent", "Electricity", ""] });
+    expect(res.status).toBe(200);
+    const body = (await res.json()) as StepResponse;
+    expect(body.reply).toMatchObject({ reply: "You listed “Rent” and “Electricity”. What orders them is the date.", generated: false });
+    expect(h.askedForReply()).toBe(false);
+    const row = await h.db.select().from(schema.dayResponse).get();
+    expect(row?.stepAnswers?.ask?.reply).toBe(body.reply.reply);
+  });
+
+  it("an edited answer gets a line about the new words, never the old ones", async () => {
+    const h = harness();
+    await seedDay(h.db);
+    await h.step({ stepId: "take", value: "Rent: to confirm." });
+    const edited = (await (await h.step({ stepId: "take", value: "Rent: the 5th." })).json()) as StepResponse;
+    // Her words, quoted without their closing full stop (`quotable`), as every template quotes.
+    expect(edited.reply.reply).toBe("Your note: “Rent: the 5th”.");
+    const row = await h.db.select().from(schema.dayResponse).get();
+    expect(row?.stepAnswers?.take?.value).toBe("Rent: the 5th.");
+    expect(row?.stepAnswers?.take?.reply).toBe("Your note: “Rent: the 5th”.");
+    expect(h.askedForReply()).toBe(false);
+  });
+
+  it("a skip is never answered with a teaching line (it takes the route's ordinary path, unchanged)", async () => {
+    const h = harness();
+    await seedDay(h.db);
+    const body = (await (await h.step({ stepId: "ask", value: null, auto: true })).json()) as StepResponse;
+    expect(body.reply.reply ?? "").not.toMatch(/What orders/);
+  });
+});
