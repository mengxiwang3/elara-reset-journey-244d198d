diff --git a/apps/mobile/src/components/system/loadingLabel.test.ts b/apps/mobile/src/components/system/loadingLabel.test.ts
new file mode 100644
index 0000000..7d9ccad
--- /dev/null
+++ b/apps/mobile/src/components/system/loadingLabel.test.ts
@@ -0,0 +1,41 @@
+import { readFileSync } from "node:fs";
+import { resolve } from "node:path";
+import { describe, expect, it } from "vitest";
+
+/**
+ * Issue 08: a loading button keeps words next to its spinner, and still blocks
+ * a second tap. There is no renderer in these Node tests, so the three button
+ * components are read as source: each loading branch draws a label beside a
+ * small spinner, and each keeps `disabled` while loading.
+ */
+const src = (p: string) => readFileSync(resolve(__dirname, p), "utf8");
+/** The busy rendering: from its small spinner to a few lines after it. */
+const loadingBranch = (code: string) => {
+  const i = code.indexOf('ActivityIndicator size="small"');
+  return i < 0 ? "" : code.slice(i, i + 400);
+};
+
+describe("loading buttons say what is happening (issue 08)", () => {
+  for (const [name, file, blocked] of [
+    ["PrimaryPill", "./PrimaryPill.tsx", "disabled={off || loading}"],
+    ["Button (Gradient/Forest/Outline)", "../Button.tsx", "disabled={disabled || loading"],
+    ["Explore PrimaryButton", "../explore/Detail.tsx", "disabled={disabled || loading}"],
+  ] as const) {
+    it(`${name}: a small spinner and a label, never the spinner alone; repeat taps blocked`, () => {
+      const code = src(file);
+      const branch = loadingBranch(code);
+      expect(branch).toContain('ActivityIndicator size="small"');
+      expect(branch).toMatch(/AppText|<Label/);
+      expect(branch).toMatch(/loadingLabel \?\?|loadingText|busyLabel/);
+      expect(code).toContain(blocked);
+    });
+  }
+
+  it("the affected call sites name their busy words", () => {
+    expect(src("../circles/circulos/CircleScreen.tsx")).toContain("loadingLabel={t.circle.circles.joining}");
+    expect(src("../circles/circulos/CompartirSheet.tsx")).toContain("loadingLabel={t.circle.feedBeta.publishing}");
+    expect(src("../../../app/topic-compose.tsx")).toContain("loadingLabel={t.circle.feedBeta.publishing}");
+    expect(src("../../../app/(tabs)/explore/resource/[id].tsx")).toContain("loadingLabel={t.common.action.saving}");
+    expect(src("../../../app/(tabs)/explore/event-detail/[id].tsx")).toContain("loadingLabel={t.common.action.saving}");
+  });
+});
