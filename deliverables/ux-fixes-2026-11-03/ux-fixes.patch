+    expect(sanitize('Dijiste todo bien, y con eso cierras el día."')).toBe('Dijiste todo bien, y con eso cierras el día."');
+    expect(sanitize("«Dijiste todo bien, y con eso cierras el día.")).toBe("«Dijiste todo bien, y con eso cierras el día.");
+  });
+});
+
+/**
+ * Issue 05 (3 Nov 2026): answers are saved in the day's history automatically;
+ * a phrase reaches «Frases que guardaste» only when she saves it.
+ */
+describe("issue 05: saving a phrase is her choice", () => {
+  let h: ReturnType<typeof harness>;
+  beforeEach(async () => {
+    vi.spyOn(console, "error").mockImplementation(() => {});
+    vi.spyOn(console, "warn").mockImplementation(() => {});
+    h = harness();
+    await seedUser(h.db, "ana");
+    await seedPath(h.db);
+  });
+
+  it("answering a keep step stores the answer, marked not saved", async () => {
+    await h.step(1, { stepId: "ask", value: "Mejorar mi trabajo actual" });
+    await h.step(1, { stepId: "take", value: "Todo bien" });
+    const answers = await storedAnswers(h.db, 1);
+    expect(answers.take!.value).toBe("Todo bien");
+    expect(answers.take!.saved).toBe(false);
+    // A step that keeps nothing carries no flag.
+    expect("saved" in answers.ask!).toBe(false);
+  });
+
+  it("«Guardar esta frase» sets it, taking it off clears it, and the answer stays in the day", async () => {
+    await h.step(1, { stepId: "ask", value: "Mejorar mi trabajo actual" });
+    await h.step(1, { stepId: "take", value: "Todo bien" });
+    const on = await h.saved(1, "take", true);
+    expect(on.status).toBe(200);
+    const body = (await on.json()) as { saved: number | false };
+    expect(typeof body.saved).toBe("number");
+    expect((await storedAnswers(h.db, 1)).take!.saved).toBe(body.saved);
+    // An edit of saved words stays saved.
+    await h.step(1, { stepId: "take", value: "Todo bien, de verdad" });
+    expect((await storedAnswers(h.db, 1)).take!.saved).toBe(body.saved);
+    const off = await h.saved(1, "take", false);
+    expect(off.status).toBe(200);
+    const after = await storedAnswers(h.db, 1);
+    expect(after.take!.saved).toBe(false);
+    expect(after.take!.value).toBe("Todo bien, de verdad");
+  });
+
+  it("refuses a step that keeps no phrase, and one with no answer", async () => {
+    await h.step(1, { stepId: "ask", value: "Mejorar mi trabajo actual" });
+    expect((await h.saved(1, "ask", true)).status).toBe(400);
+    expect((await h.saved(1, "take", true)).status).toBe(404);
+  });
+});
diff --git a/apps/api/test/wellbeing-sessions.test.ts b/apps/api/test/wellbeing-sessions.test.ts
new file mode 100644
index 0000000..30f8582
--- /dev/null
+++ b/apps/api/test/wellbeing-sessions.test.ts
@@ -0,0 +1,98 @@
+import { describe, expect, it } from "vitest";
+import { listSnapshots, score, snapshotWeek } from "../src/services/wellbeing";
+import { createTestDb, schema, seedUser } from "./helpers/db";
+
+/**
+ * Issue 04 (3 Nov 2026): «Sesiones completadas» counts completed daily
+ * sessions (path days finished that week), read live from `day_response`
+ * alongside the frozen snapshot, which is never rewritten.
+ *
+ * NOW is Sunday 15 Mar 2026: the last complete week is 2-8 Mar.
+ */
+const NOW = new Date("2026-03-15T12:00:00Z");
+
+async function seed() {
+  const db = createTestDb();
+  await seedUser(db, "u1");
+  await db.insert(schema.userPath).values({ id: "p1", userId: "u1", area: "money", startedAt: new Date("2026-02-01T00:00:00Z") });
+  return db;
+}
+
+async function done(db: ReturnType<typeof createTestDb>, day: number, at: string, on: string | null) {
+  await db.insert(schema.dayResponse).values({
+    id: `d${day}`,
+    userPathId: "p1",
+    day,
+    stepAnswers: {},
+    completedAt: new Date(at),
+    completedOn: on,
+  });
+}
+
+describe("completed sessions per week", () => {
+  it("zero-data: no snapshot and nothing completed is missing (null), never 0", async () => {
+    const db = await seed();
+    const weeks = await listSnapshots(db, "u1", NOW);
+    expect(weeks.every((w) => w.sessionsCompleted === null)).toBe(true);
+  });
+
+  it("sparse: a stored week with no finished day is a real 0; answered steps are not sessions", async () => {
+    const db = await seed();
+    // Two active days with four answered steps (the recording's week): agency 80 in the stored score.
+    const sig = (d: string) => ({
+      id: `s${d}`,
+      userId: "u1",
+      source: "path_day",
+      kind: "answered",
+      refId: null,
+      payload: null,
+      derived: null,
+      at: new Date(`2026-03-${d}T20:00:00Z`),
+      localDate: `2026-03-${d}`,
+      annotatedAt: null,
+      annotateAttempts: 0,
+    });
+    const signals = ["02", "02", "03", "03"].map((d, i) => ({ ...sig(d), id: `s${i}` })) as never[];
+    const scored = score({ periodStart: "2026-03-02", periodEnd: "2026-03-08" }, [], signals, 0);
+    expect(scored.scores.agency).toBe(80);
+    expect(scored.scores.engagement).toBe(29);
+    expect(scored.daysActive).toBe(2);
+    await db.insert(schema.wellbeingSnapshot).values({
+      id: "w1",
+      userId: "u1",
+      periodStart: "2026-03-02",
+      periodEnd: "2026-03-08",
+      scores: scored.scores,
+      confidence: Math.round(scored.confidence * 100),
+      topThemes: [],
+      checkIns: 0,
+      daysActive: 2,
+    });
+    const weeks = await listSnapshots(db, "u1", NOW);
+    const last = weeks[weeks.length - 1]!;
+    expect(last.periodStart).toBe("2026-03-02");
+    expect(last.sessionsCompleted).toBe(0);
+    // The frozen scores are returned as stored.
+    expect(last.scores.agency).toBe(80);
+  });
+
+  it("complete: counts days finished in the week by their stored date, with the pre-0054 fallback", async () => {
+    const db = await seed();
+    await snapshotWeek(db, "u1", { periodStart: "2026-03-02", periodEnd: "2026-03-08" });
+    await done(db, 1, "2026-03-02T20:00:00Z", "2026-03-02");
+    await done(db, 2, "2026-03-03T20:00:00Z", "2026-03-03");
+    // Finished late on Sunday 8 Mar in her zone, already Monday in UTC: counted by completed_on.
+    await done(db, 3, "2026-03-09T02:00:00Z", "2026-03-08");
+    // An older row with no completed_on: dated from completed_at (UTC here, no zone stored).
+    await done(db, 4, "2026-03-05T10:00:00Z", null);
+    // Not finished in that week.
+    await done(db, 5, "2026-03-10T10:00:00Z", "2026-03-10");
+    await done(db, 6, "2026-02-23T10:00:00Z", "2026-02-23");
+    const weeks = await listSnapshots(db, "u1", NOW);
+    const byStart = new Map(weeks.map((w) => [w.periodStart, w]));
+    expect(byStart.get("2026-03-02")!.sessionsCompleted).toBe(4);
+    // A week with no stored snapshot but a finished day still shows the count.
+    expect(byStart.get("2026-02-23")!.sessionsCompleted).toBe(1);
+    expect(byStart.get("2026-02-23")!.confidence).toBe(0);
+  });
+});
