+export async function setPhraseSaved(
+  db: Db,
+  userId: string,
+  area: AreaKey,
+  day: number,
+  stepId: string,
+  saved: boolean,
+  locale: Locale = DEFAULT_LOCALE,
+): Promise<{ saved: number | false }> {
+  const state = await loadDayState(db, userId, area, day);
+  const row = state.rows.find((r) => r.day === day);
+  const answer = row?.stepAnswers?.[stepId];
+  if (!state.path || !row || !answer) throw notFound("No answer to save", "answer_not_found");
+  const authored = (await authoredPath(db, area, locale, state.contentVersion)).days.find((d) => d.day === day);
+  const step = authored ? stepsOf(authored).find((s) => s.id === stepId) : undefined;
+  if (!step?.config?.keep || step.config.hidden) throw badRequest("This step keeps no phrase", "not_a_phrase");
+  if (answer.value == null || answer.safety || hasStateAnswer(answer)) {
+    throw badRequest("Only her written words can be saved", "not_a_phrase");
+  }
+  const value: number | false = saved ? (typeof answer.saved === "number" ? answer.saved : Date.now()) : false;
+  await db
+    .update(dayResponse)
+    .set({ stepAnswers: sql`json_set(${dayResponse.stepAnswers}, ${`${jsonKey(stepId)}.saved`}, json(${JSON.stringify(value)}))` })
+    .where(and(eq(dayResponse.id, row.id), sql`json_type(${dayResponse.stepAnswers}, ${jsonKey(stepId)}) is not null`));
+  return { saved: value };
+}
