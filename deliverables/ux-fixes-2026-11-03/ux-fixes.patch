+/** The quote pairs a model wraps a whole reply in: open, close. */
+const QUOTE_PAIRS: readonly (readonly [string, string])[] = [
+  ['"', '"'],
+  ["“", "”"],
+  ["«", "»"],
+  ["'", "'"],
+  ["‘", "’"],
+];
+/** Marks that, inside the text, mean a quoted phrase of its own: an apostrophe in "don't" is not one, unless the pair is apostrophes. */
+const DOUBLE_MARKS = /["“”«»]/;
+const ANY_MARKS = /["“”«»'‘’]/;
+
+/**
+ * Strip quotation marks only when ONE matching pair wraps the whole reply,
+ * with no quote mark of any kind inside it. A quote that opens or closes a
+ * phrase inside the reply (`"Todo bien" no deja claro…`, `Dijiste "todo
+ * bien"`) is part of the reply and is never touched; nor is a single unmatched
+ * mark at either end. (Issue 02: the old `^["“”']+|["“”']+$` strip took one
+ * side of an embedded quote and left the other.)
+ */
+export function unwrapQuotes(text: string): string {
+  for (const [open, close] of QUOTE_PAIRS) {
+    if (text.length > 2 && text.startsWith(open) && text.endsWith(close)) {
+      const inner = text.slice(open.length, text.length - close.length);
+      const single = open === "'" || open === "‘";
+      if (!(single ? ANY_MARKS : DOUBLE_MARKS).test(inner)) return inner.trim();
+    }
+  }
+  return text;
+}
