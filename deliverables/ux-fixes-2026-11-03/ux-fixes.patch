+import { describe, expect, it } from "vitest";
+import { isSavedPhrase, savedAfterEdit, type DayStep } from "@elara/shared";
+import { progressAfterAnswer, progressWithSaved, type AnswerProgress } from "@/store/stepAnswer";
+import { phraseOf, questionLine } from "./phrase";
+
+/** Issue 05: saving a phrase is her choice; her words always come with their question. */
+const ASK: DayStep = { id: "ask", kind: "choose", title: "¿Qué describe mejor cómo va tu tarea?", config: { options: ["La hice", "Aún no"] } };
+const TAKE: DayStep = {
+  id: "take",
+  kind: "reflect",
+  title: "Para llevarte",
+  body: "Dijiste «{ask|lower}». ¿Qué es lo siguiente que necesitarías saber? También puedes escribir que lo dejas aquí por ahora.",
+  config: {
+    keep: "sentence",
+    bodyFallback: "¿Qué es lo siguiente que necesitarías saber sobre tu tarea? También puedes escribir que lo dejas aquí por ahora.",
+  },
+};
+const STEPS = [ASK, TAKE];
+
+describe("the saved flag", () => {
+  it("reads an absent flag (shelved automatically before) as saved, false as not, a time as saved", () => {
+    expect(isSavedPhrase({})).toBe(true);
+    expect(isSavedPhrase({ saved: false })).toBe(false);
+    expect(isSavedPhrase({ saved: 5 })).toBe(true);
+    expect(isSavedPhrase(undefined)).toBe(false);
+  });
+
+  it("is not set by answering; an edit of saved words stays saved", () => {
+    expect(savedAfterEdit(undefined, 9)).toBe(false);
+    expect(savedAfterEdit({ value: "Todo bien", saved: false }, 9)).toBe(false);
+    expect(savedAfterEdit({ value: "Todo bien", saved: 3 }, 9)).toBe(3);
+    // Written before explicit saving, so shelved then: still saved after the edit.
+    expect(savedAfterEdit({ value: "Todo bien" }, 9)).toBe(9);
+    // A state was there, not her words: nothing to carry.
+    expect(savedAfterEdit({ value: null, state: "skipped" }, 9)).toBe(false);
+  });
+
+  it("answering on this phone records `saved: false` on a keep step, and the toggle sets and clears it", () => {
+    const p0: AnswerProgress = { currentDay: 1, completedDays: [], responses: {}, stepAnswers: {} };
+    const p1 = progressAfterAnswer(p0, { day: 25, steps: STEPS, stepId: "take", value: "Todo bien", now: 1, totalDays: 30 });
+    expect(p1.stepAnswers[25]!.take!.saved).toBe(false);
+    const p2 = progressAfterAnswer(p1, { day: 25, steps: STEPS, stepId: "ask", value: "Aún no", now: 2, totalDays: 30 });
+    expect("saved" in p2.stepAnswers[25]!.ask!).toBe(false);
+    const p3 = progressWithSaved(p2, 25, "take", 7);
+    expect(isSavedPhrase(p3.stepAnswers[25]!.take)).toBe(true);
+    // Her history keeps the answer either way.
+    expect(progressWithSaved(p3, 25, "take", false).stepAnswers[25]!.take!.value).toBe("Todo bien");
+  });
+});
+
+describe("her phrase and its question", () => {
+  it("shows «Todo bien» as her answer, never filtered by length", () => {
+    expect(phraseOf(STEPS, { ask: { value: 1 }, take: { value: "Todo bien" } })).toEqual({ step: TAKE, text: "Todo bien" });
+  });
+
+  it("is nothing for a skip, a state or a flagged answer", () => {
+    expect(phraseOf(STEPS, { take: { value: null, state: "skipped" } })).toBeNull();
+    expect(phraseOf(STEPS, { take: { value: "x", safety: 2 } })).toBeNull();
+  });
+
+  it("names the question she was asked, filled with her own choice, else its fallback", () => {
+    const book = { 25: { ask: { value: 1 } } };
+    const stepAt = (_d: number, id: string) => STEPS.find((s) => s.id === id);
+    expect(questionLine(TAKE, { book, day: 25, stepAt })).toBe("¿Qué es lo siguiente que necesitarías saber?");
+    expect(questionLine(TAKE, { book: {}, day: 25, stepAt })).toBe("¿Qué es lo siguiente que necesitarías saber sobre tu tarea?");
+    // A task, not a question: the line as written.
+    const task: DayStep = { id: "t", kind: "reflect", title: "Para llevarte", body: "Crea un recordatorio sin datos financieros, en foto o texto." };
+    expect(questionLine(task, { book: {}, day: 1 })).toBe("Crea un recordatorio sin datos financieros, en foto o texto.");
+  });
+});
