+++ b/apps/mobile/src/lib/phrase.ts
@@ -0,0 +1,43 @@
+import {
+  answerText,
+  resolveTemplate,
+  stepOutcome,
+  type DayStep,
+  type DayStepAnswers,
+  type TemplateContext,
+} from "@elara/shared";
+
+/**
+ * Issue 05 (3 Nov 2026): her phrase, and the question it answers.
+ *
+ * Her words are quoted verbatim and never filtered by length: «Todo bien» is
+ * an honest answer, shown as her answer with its question. Never a skip, a
+ * state, a hidden step or an answer that matched the safety list.
+ */
+export function phraseOf(
+  steps: readonly DayStep[],
+  answers: DayStepAnswers | undefined,
+): { step: DayStep; text: string } | null {
+  for (const step of [...steps].reverse()) {
+    if (!step.config?.keep || step.config.hidden) continue;
+    const answer = answers?.[step.id];
+    if (!answer || answer.safety || stepOutcome(step, answer) !== "answered") continue;
+    const text = answerText(answer.value, step).trim();
+    if (text) return { step, text };
+  }
+  return null;
+}
+
+/**
+ * The question or task a step put to her, as she saw it, in one line: its
+ * line under the heading (templates filled, its fallback when they cannot
+ * be), cut to the sentence that asks, else the heading. «Para llevarte» is a
+ * heading; «¿Qué es lo siguiente que necesitarías saber?» is the question.
+ */
+export function questionLine(step: DayStep, ctx: TemplateContext): string | null {
+  const body = resolveTemplate(step.body, step.config?.bodyFallback, ctx)?.text?.trim();
+  const source = body || step.config?.prompt?.trim() || step.title?.trim() || "";
+  if (!source) return null;
+  const asking = source.match(/¿[^?]*\?|[^.!?¿]*\?/);
+  return (asking ? asking[0] : source).trim() || null;
+}
