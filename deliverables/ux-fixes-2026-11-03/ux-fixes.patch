+import { describe, expect, it } from "vitest";
+import { defaultSnapshot, type WellbeingSnapshotDTO } from "@elara/shared";
+import { es } from "@/i18n/locales/es";
+import { comparison, metricRows, pickWeeks, sparseWeek } from "./weekMetrics";
+
+/** Issue 04: Presencia as days, «Sesiones completadas», no percentage, honest gaps and comparisons. */
+const week = (start: string, over: Partial<WellbeingSnapshotDTO> = {}): WellbeingSnapshotDTO => ({
+  ...defaultSnapshot(start, start),
+  ...over,
+});
+const row = (rows: ReturnType<typeof metricRows>, d: string) => rows.find((r) => r.dimension === d)!;
+
+describe("weekly metrics (issue 04)", () => {
+  it("a zero-data history has no week to show and nothing to compare", () => {
+    const weeks = [week("2026-10-13"), week("2026-10-20"), week("2026-10-27")];
+    expect(pickWeeks(weeks)).toEqual({ latest: undefined, previous: undefined });
+    expect(comparison(undefined, undefined)).toBeNull();
+    // A week with no snapshot: every row is missing, never 0.
+    const rows = metricRows(week("2026-10-27"));
+    expect(rows.every((r) => r.value === null && r.meter === null && r.delta === null)).toBe(true);
+  });
+
+  it("a sparse week (the recording: 2 days, 0 check-ins, 4 answered steps, 1 session): counts, no %", () => {
+    const latest = week("2026-10-27", {
+      // The old stored scores stay in the snapshot; Presencia and Sesiones no longer read them.
+      scores: { mood: null, stability: null, engagement: 29, agency: 80, connection: 0, outlook: null },
+      confidence: 0.24,
+      daysActive: 2,
+      checkIns: 0,
+      sessionsCompleted: 1,
+    });
+    const rows = metricRows(latest);
+    expect(row(rows, "engagement")).toMatchObject({ unit: "days", value: 2 });
+    expect(es.account.progress.daysOf(row(rows, "engagement").value!)).toBe("2 de 7 días");
+    expect(row(rows, "agency")).toMatchObject({ unit: "count", value: 1 });
+    expect(es.account.progress.dimensions.agency.label).toBe("Sesiones completadas");
+    // Missing stays missing; a measured zero stays zero.
+    expect(row(rows, "mood").value).toBeNull();
+    expect(row(rows, "connection").value).toBe(0);
+    expect(row(rows, "connection").meter).toBe(0);
+    expect(sparseWeek(latest)).toBe(true);
+    const basis = es.account.progress.weekBasis(latest.daysActive, latest.checkIns, sparseWeek(latest));
+    expect(basis).toBe("2 días activos · 0 registros · lectura con pocos datos");
+    expect(basis).not.toMatch(/%/);
+  });
+
+  it("an observed week with no session finished shows 0, not «Sin datos»; an older API without the field shows «—»", () => {
+    const zero = metricRows(week("2026-10-27", { confidence: 0.12, daysActive: 1, sessionsCompleted: 0 }));
+    expect(row(zero, "agency").value).toBe(0);
+    const old = metricRows(week("2026-10-27", { confidence: 0.12, daysActive: 1 }));
+    expect(row(old, "agency").value).toBeNull();
+  });
+
+  it("a complete week compared with the calendar week before it", () => {
+    const prev = week("2026-10-20", {
+      scores: { mood: 60, stability: 70, engagement: 71, agency: 100, connection: 20, outlook: 55 },
+      confidence: 0.8,
+      daysActive: 5,
+      checkIns: 3,
+      sessionsCompleted: 4,
+    });
+    const latest = week("2026-10-27", {
+      scores: { mood: 72, stability: 70, engagement: 100, agency: 100, connection: 40, outlook: null },
+      confidence: 1,
+      daysActive: 7,
+      checkIns: 6,
+      sessionsCompleted: 7,
+    });
+    const { latest: l, previous: p } = pickWeeks([prev, latest]);
+    expect(l).toBe(latest);
+    expect(comparison(l, p)).toEqual({ periodStart: "2026-10-20", adjacent: true });
+    const rows = metricRows(latest, prev);
+    expect(row(rows, "engagement")).toMatchObject({ value: 7, delta: 2, meter: 100 });
+    expect(row(rows, "agency")).toMatchObject({ value: 7, delta: 3 });
+    expect(row(rows, "mood").delta).toBe(12);
+    expect(row(rows, "outlook").delta).toBeNull();
+    expect(sparseWeek(latest)).toBe(false);
+    expect(es.account.progress.weekBasis(7, 6, false)).toBe("7 días activos · 6 registros");
+    expect(es.account.progress.deltaDays(2)).toBe("+2 días");
+    expect(es.account.progress.comparedTo("20 oct")).toBe("Los cambios se comparan con la semana del 20 oct.");
+  });
+
+  it("says so when the comparison week is not the calendar week before", () => {
+    const weeks = [
+      week("2026-10-06", { confidence: 0.6, daysActive: 5, sessionsCompleted: 3 }),
+      week("2026-10-13"),
+      week("2026-10-20"),
+      week("2026-10-27", { confidence: 0.24, daysActive: 2, sessionsCompleted: 1 }),
+    ];
+    const { latest, previous } = pickWeeks(weeks);
+    expect(comparison(latest, previous)).toEqual({ periodStart: "2026-10-06", adjacent: false });
+    expect(es.account.progress.comparedToEarlier("6 oct")).toContain("no la semana inmediatamente anterior");
+  });
+});
diff --git a/apps/mobile/src/lib/weekMetrics.ts b/apps/mobile/src/lib/weekMetrics.ts
new file mode 100644
index 0000000..fdd7b8c
--- /dev/null
+++ b/apps/mobile/src/lib/weekMetrics.ts
@@ -0,0 +1,88 @@
+import type { WellbeingDimension, WellbeingSnapshotDTO } from "@elara/shared";
+import { WELLBEING_DIMENSIONS } from "@elara/shared";
+
+/**
+ * The weekly metrics on «Cómo has estado», as rows the screen draws (issue 04,
+ * 3 Nov 2026). Pure, so the rules are tested without a screen:
+ *
+ * - Presencia is a count of days («2 de 7 días»), not a percentage.
+ * - The `agency` row is «Sesiones completadas»: daily sessions finished that
+ *   week (`sessionsCompleted`), not answered questions. The stored `agency`
+ *   score is left in the snapshot and no longer shown.
+ * - Missing is not zero: `value: null` means no data («—», «Sin datos»), a
+ *   real 0 stays 0.
+ * - A change is only shown with the week it is compared with, and whether that
+ *   week is the calendar week just before.
+ */
+export type MetricUnit = "score" | "days" | "count";
+
+export interface MetricRow {
+  dimension: WellbeingDimension;
+  unit: MetricUnit;
+  /** Null: nothing measured that week. 0: measured, and zero. */
+  value: number | null;
+  /** 0-100 for the meter, null for no bar. */
+  meter: number | null;
+  /** Change against the comparison week, or null when either side is missing. */
+  delta: number | null;
+}
+
+/** A week counts as read when it has a stored snapshot behind it. */
+export const hasData = (w: WellbeingSnapshotDTO) => w.confidence > 0;
+
+/** The last week with data, and the one with data before it (not necessarily adjacent). */
+export function pickWeeks(weeks: readonly WellbeingSnapshotDTO[]): {
+  latest: WellbeingSnapshotDTO | undefined;
+  previous: WellbeingSnapshotDTO | undefined;
+} {
+  const latest = [...weeks].reverse().find(hasData);
+  if (!latest) return { latest: undefined, previous: undefined };
+  const i = weeks.findIndex((w) => w.periodStart === latest.periodStart);
+  const previous = [...weeks.slice(0, i)].reverse().find(hasData);
+  return { latest, previous };
+}
+
+function daysBetween(a: string, b: string): number {
+  return Math.round((Date.parse(`${b}T00:00:00Z`) - Date.parse(`${a}T00:00:00Z`)) / 86_400_000);
+}
+
+/** The comparison week, and whether it is the calendar week just before `latest`. */
+export function comparison(
+  latest: WellbeingSnapshotDTO | undefined,
+  previous: WellbeingSnapshotDTO | undefined,
+): { periodStart: string; adjacent: boolean } | null {
+  if (!latest || !previous) return null;
+  return { periodStart: previous.periodStart, adjacent: daysBetween(previous.periodStart, latest.periodStart) === 7 };
+}
+
+function valueOf(w: WellbeingSnapshotDTO | undefined, d: WellbeingDimension): { unit: MetricUnit; value: number | null } {
+  if (!w) return { unit: d === "engagement" ? "days" : d === "agency" ? "count" : "score", value: null };
+  if (d === "engagement") return { unit: "days", value: hasData(w) ? w.daysActive : null };
+  if (d === "agency") return { unit: "count", value: w.sessionsCompleted ?? null };
+  return { unit: "score", value: w.scores[d] ?? null };
+}
+
+export function metricRows(latest: WellbeingSnapshotDTO, previous?: WellbeingSnapshotDTO): MetricRow[] {
+  return WELLBEING_DIMENSIONS.map((dimension) => {
+    const now = valueOf(latest, dimension);
+    const before = previous ? valueOf(previous, dimension).value : null;
+    const meter =
+      now.value == null
+        ? null
+        : now.unit === "score"
+          ? now.value
+          : Math.round((Math.min(now.value, 7) / 7) * 100);
+    return {
+      dimension,
+      unit: now.unit,
+      value: now.value,
+      meter,
+      delta: now.value != null && before != null ? now.value - before : null,
+    };
+  });
+}
+
+/** A week read from little data: fewer than five days or check-ins behind it (the old 24% line, in words). */
+export function sparseWeek(w: WellbeingSnapshotDTO): boolean {
+  return w.confidence < 0.5;
+}
